{
  "name": "zotero-hjfy-ai-split-reader",
  "type": "module",
  "version": "0.1.5-ai.3",
  "description": "HJFY and OpenAI-compatible AI PDF translation with preserved layout and split-view reading (local fork)",
  "config": {
    "addonName": "HJFY + AI Split Reader CN",
    "addonID": "zotero-hjfy-split-reader-cn@leisongju.github.io",
    "addonRef": "zotero-hjfy-split-reader-cn",
    "addonInstance": "ZoteroHJFYSplitReaderCN",
    "prefsPrefix": "extensions.zotero.hjfySplitReaderCN"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l00100/zotero-hjfy-ai-split-reader.git"
  },
  "author": "4b and contributors",
  "bugs": {
    "url": "https://github.com/l00100/zotero-hjfy-ai-split-reader/issues"
  },
  "homepage": "https://github.com/l00100/zotero-hjfy-ai-split-reader#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release:check": "npm run lint:check && npm run build",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save",
    "test:unit": "node --test test/ai-core.node.mjs",
    "test:service": "python -m unittest discover -s tests -v",
    "package:release": "python scripts/package_release.py"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "contributors": [
    {
      "name": "l00100 (AI translation enhancements)",
      "url": "https://github.com/l00100"
    }
  ]
}
